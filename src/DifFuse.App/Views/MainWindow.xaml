<Window x:Class="DifFuse.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:DifFuse.App.Views"
        xmlns:vm="clr-namespace:DifFuse.App.ViewModels"
        Title="DifFuse"
        Width="1320" Height="860" MinWidth="980" MinHeight="600"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="/Assets/DifFuse.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#D9141518" BorderBrush="#FF25272C" BorderThickness="0,0,0,1" Padding="14,10,14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="2,0,18,0">
                    <TextBlock FontFamily="{StaticResource PanelFont}" FontSize="24" FontWeight="SemiBold" LineHeight="24">
                        <Run Text="Dif" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="Fuse" Foreground="{StaticResource AccentBrush}" />
                    </TextBlock>
                    <TextBlock Text="Mustang amp editor" FontFamily="{StaticResource PanelFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <!-- Preset display -->
                <Border Grid.Column="1" Background="{StaticResource LcdBgBrush}" BorderBrush="#FF050403" BorderThickness="1" CornerRadius="5"
                        Padding="14,6" MaxWidth="620" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#FFF2A43A" BlurRadius="14" ShadowDepth="0" Opacity="0.08" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CurrentSlotText}" FontFamily="{StaticResource LcdFont}" FontSize="20"
                                   Foreground="{StaticResource LcdDimBrush}" VerticalAlignment="Center" Margin="0,0,14,0"
                                   AutomationProperties.Name="Current preset slot" />
                        <TextBlock Grid.Column="1" Text="{Binding PresetName}" FontFamily="{StaticResource LcdFont}" FontSize="20"
                                   Foreground="{StaticResource LcdTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.Name="Current preset name" />
                        <Border Grid.Column="2" Margin="12,0,0,0" Padding="7,1" CornerRadius="3" VerticalAlignment="Center"
                                BorderBrush="{StaticResource LcdDimBrush}" BorderThickness="1"
                                Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="The rack differs from the preset stored on the amp">
                            <TextBlock Text="EDITED" FontFamily="{StaticResource LcdFont}" FontSize="11" Foreground="{StaticResource LcdTextBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Connection -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,14,0">
                    <Ellipse Width="11" Height="11" Fill="{Binding State, Converter={StaticResource ConnectionLed}}" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#FF5BE36F" BlurRadius="8" ShadowDepth="0" Opacity="0.6" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <StackPanel Margin="9,0,0,0">
                        <TextBlock Text="{Binding DeviceName}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ConnectionText}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ReconnectCommand}" Margin="0,0,8,0"
                            ToolTip="Drop the USB connection and connect again" AutomationProperties.Name="Reconnect">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
                            <TextBlock Text="Reconnect" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButton}" Command="{Binding SaveToAmpCommand}"
                            ToolTip="Store the current sound in one of the amp's preset slots" AutomationProperties.Name="Save to amp">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" />
                            <TextBlock Text="Save to amp…" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="248" MinWidth="210" MaxWidth="440" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="700" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="#D9171819">
                <TabControl x:Name="SidebarTabs">
                    <TabItem Header="AMP PRESETS" AutomationProperties.Name="Amp presets">
                        <Grid Margin="10,0,6,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="2,2,0,6">
                                <Run Text="ON THE AMP" /><Run Text="  ·  " Foreground="{StaticResource TextMutedBrush}" /><Run Text="{Binding Slots.Count, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" /><Run Text=" slots" Foreground="{StaticResource TextMutedBrush}" />
                            </TextBlock>
                            <Border Grid.Row="1" Margin="0,0,4,8" Padding="10,8" CornerRadius="4" Background="#FF221B10" BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5"
                                           Text="Plug the amp in with its USB cable and switch it on. DifFuse finds it by itself." />
                            </Border>
                            <ListBox Grid.Row="2" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                                     ItemContainerStyle="{StaticResource RackListItem}" IsEnabled="{Binding IsConnected}"
                                     AutomationProperties.Name="Amp preset slots" VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PresetSlotViewModel}">
                                        <Grid AutomationProperties.Name="{Binding Label}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                     Visibility="{Binding IsCurrent, Converter={StaticResource HiddenWhenFalse}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Number}" FontFamily="{StaticResource LcdFont}" FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="LIBRARY" AutomationProperties.Name="Preset library">
                        <Grid Margin="10,0,6,10" DataContext="{Binding Library}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="BANK" Margin="2,2,0,6" />
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Banks}" SelectedItem="{Binding SelectedBank}" DisplayMemberPath="Name"
                                          AutomationProperties.Name="Bank" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding NewBankCommand}" ToolTip="New bank" AutomationProperties.Name="New bank" Margin="0,0,3,0">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding RenameBankCommand}" ToolTip="Rename bank" AutomationProperties.Name="Rename bank" Margin="0,0,3,0">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8AC;" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteBankCommand}" ToolTip="Move bank to the Recycle Bin" AutomationProperties.Name="Delete bank" Margin="0,0,3,0">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding OpenFolderCommand}" ToolTip="Open the bank folder" AutomationProperties.Name="Open bank folder">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ListBox x:Name="LibraryList" Grid.Row="2" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                     ItemContainerStyle="{StaticResource RackListItem}" DisplayMemberPath="Name"
                                     AutomationProperties.Name="Library presets" MouseDoubleClick="LibraryList_MouseDoubleClick"
                                     KeyDown="LibraryList_KeyDown" />
                            <TextBlock Grid.Row="2" TextWrapping="Wrap" Margin="4,8,4,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"
                                       Visibility="{Binding HasPresets, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                       Text="This bank is empty. Save the current sound here, or import FUSE .fuse files." />

                            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                <UniformGrid Columns="2" Margin="0,0,0,4">
                                    <Button Command="{Binding LoadCommand}" Margin="0,0,2,0" ToolTip="Play the selected preset on the amp (double-click works too)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" />
                                            <TextBlock Text="Load" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SaveCurrentCommand}" Margin="2,0,0,0" ToolTip="Save the current sound into this bank">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" />
                                            <TextBlock Text="Save here" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                                <UniformGrid Columns="4">
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding ImportCommand}" Margin="0,0,2,0" ToolTip="Import FUSE .fuse files into this bank" AutomationProperties.Name="Import FUSE files">
                                        <TextBlock Text="Import" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding ExportSelectedCommand}" Margin="2,0" ToolTip="Export the selected preset as a FUSE .fuse file" AutomationProperties.Name="Export selected preset">
                                        <TextBlock Text="Export" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding RenamePresetCommand}" Margin="2,0" ToolTip="Rename the selected preset" AutomationProperties.Name="Rename preset">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8AC;" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding DeletePresetCommand}" Margin="2,0,0,0" ToolTip="Move the selected preset to the Recycle Bin" AutomationProperties.Name="Delete preset">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" />
                                    </Button>
                                </UniformGrid>
                                <Button Style="{StaticResource ToolButton}" Command="{Binding ExportCurrentCommand}" Margin="0,4,0,0"
                                        ToolTip="Export the sound in the rack as a FUSE .fuse file">
                                    <TextBlock Text="Export current sound as .fuse…" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="#FF0C0D0F" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Focusable="False" AutomationProperties.Name="Resize sidebar" />

            <!-- Rack -->
            <Border Grid.Column="2" Background="{StaticResource ChassisBrush}">
                <ScrollViewer x:Name="RackScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="RackPanel" Margin="14,12,14,10">

                        <!-- Signal chain -->
                        <Grid Margin="20,0,20,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="SIGNAL CHAIN" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Chain}" Focusable="False" AutomationProperties.Name="Signal chain">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChainItemViewModel}">
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding ToolTip}">
                                            <TextBlock Text="&#xE76C;" Style="{StaticResource IconText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="6,0" />
                                            <Border CornerRadius="3" Padding="8,2" BorderThickness="1"
                                                    BorderBrush="{Binding AccentKey, Converter={StaticResource ResourceBrush}}"
                                                    Opacity="{Binding IsActive, Converter={StaticResource ActiveOpacity}}">
                                                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource PanelFont}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{Binding AccentKey, Converter={StaticResource ResourceBrush}}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <ContentControl Style="{StaticResource RackUnit}" Background="{StaticResource AmpPanelBrush}">
                            <v:AmpUnitView DataContext="{Binding Amp}" />
                        </ContentControl>

                        <ItemsControl ItemsSource="{Binding Effects}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EffectUnitViewModel}">
                                    <ContentControl Style="{StaticResource RackUnit}">
                                        <v:EffectUnitView />
                                    </ContentControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#F00C0D0F" BorderBrush="#FF222429" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <Border DockPanel.Dock="Right" CornerRadius="3" Padding="7,1" Margin="10,0,0,0" BorderThickness="1" BorderBrush="{StaticResource AccentDimBrush}"
                        Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center">
                    <TextBlock Text="SIMULATED AMP" FontFamily="{StaticResource PanelFont}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                </Border>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Status" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
