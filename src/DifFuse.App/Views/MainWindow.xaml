<!--
    THESIS: The sound is a route. Guitar to speaker runs as one porcelain line through stations, the amp is the
    interchange, and every control's form follows its job: amounts turn, a few named positions are stops on a
    line, off/on is a switch. Refuses the photo-real rack and the card dashboard.
    OWN-WORLD: midnight-blue enamel ground, porcelain line work and rings, one line ink per unit (amp amber,
    stomp scarlet, modulation cobalt, delay green, reverb violet), Bahnschrift (DIN) for every word.
    STORY: the player sees the whole signal path at a glance, understands each control from its shape and the
    hint line, tweaks live, and saves to a slot only after confirming.
    FIRST VIEWPORT: header with the current preset signed large; under it the route diagram, input to output;
    then the amp interchange panel and four effect panels in route order, all visible at 1320x860;
    preset slots as a station list on the left; primary action "Save to amp" top right.
    FORM: midnight transit diagram, a dealt challenger chosen by the user over the assigned direction; seed 8f90a26b.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md,
    and every shipping raster carrying its provenance
-->
<Window x:Class="DifFuse.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:DifFuse.App.Services"
        xmlns:v="clr-namespace:DifFuse.App.Views"
        xmlns:vm="clr-namespace:DifFuse.App.ViewModels"
        Title="DifFuse"
        Width="1320" Height="860" MinWidth="980" MinHeight="600"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="/Assets/DifFuse.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource PanelLineBrush}" BorderThickness="0,0,0,1" Padding="16,9,16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Wordmark: four lines running into one ring -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,26,0">
                    <Canvas Width="30" Height="22" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Rectangle Canvas.Left="0" Canvas.Top="2.5" Width="20" Height="3" Fill="{StaticResource AmpBrush}" />
                        <Rectangle Canvas.Left="0" Canvas.Top="7.5" Width="20" Height="3" Fill="{StaticResource StompBrush}" />
                        <Rectangle Canvas.Left="0" Canvas.Top="12.5" Width="20" Height="3" Fill="{StaticResource ModBrush}" />
                        <Rectangle Canvas.Left="0" Canvas.Top="17.5" Width="20" Height="3" Fill="{StaticResource DelayBrush}" />
                        <Ellipse Canvas.Left="15" Canvas.Top="3.5" Width="15" Height="15" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="3" Fill="{StaticResource ChromeBrush}" />
                    </Canvas>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontStretch="Condensed" FontWeight="Bold" FontSize="23" LineHeight="23" LineStackingStrategy="BlockLineHeight">
                            <Run Text="Dif" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="Fuse" Foreground="{StaticResource AccentBrush}" />
                        </TextBlock>
                        <TextBlock Text="MUSTANG AMP EDITOR" FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Now playing: slot and preset name, signed like a station -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                    <Border BorderBrush="{StaticResource TextPrimaryBrush}" BorderThickness="1.6" CornerRadius="5" Padding="7,0,7,1" VerticalAlignment="Center"
                            AutomationProperties.Name="Current preset slot">
                        <TextBlock Text="{Binding CurrentSlotText}" FontStretch="SemiCondensed" FontWeight="Bold" FontSize="17" />
                    </Border>
                    <TextBlock Text="{Binding PresetName, Converter={StaticResource Upper}}" FontStretch="Condensed" FontWeight="Bold" FontSize="25"
                               VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="460"
                               AutomationProperties.Name="Current preset name" />
                    <Border Margin="14,0,0,0" Padding="9,2,10,3" CornerRadius="11" VerticalAlignment="Center"
                            BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1.2"
                            Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="The sound differs from the preset stored on the amp">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="EDITED" FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Connection -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,16,0">
                    <Ellipse Width="10" Height="10" Fill="{Binding State, Converter={StaticResource ConnectionLed}}" VerticalAlignment="Center" />
                    <StackPanel Margin="9,0,0,0">
                        <TextBlock Text="{Binding DeviceName}" FontSize="13.5" FontWeight="SemiBold" FontStretch="SemiCondensed" />
                        <TextBlock Text="{Binding ConnectionText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ReconnectCommand}" Margin="0,0,8,0"
                            ToolTip="Drop the USB connection and connect again" AutomationProperties.Name="Reconnect">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
                            <TextBlock Text="Reconnect" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButton}" Command="{Binding SaveToAmpCommand}"
                            ToolTip="Store the current sound in one of the amp's preset slots" AutomationProperties.Name="Save to amp">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" />
                            <TextBlock Text="Save to amp…" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="248" MinWidth="210" MaxWidth="440" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="700" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{StaticResource SidebarBrush}">
                <TabControl x:Name="SidebarTabs">
                    <TabItem Header="AMP PRESETS" AutomationProperties.Name="Amp presets">
                        <Grid Margin="10,0,6,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="4,0,0,6">
                                <Run Text="ON THE AMP" /><Run Text="  ·  " /><Run Text="{Binding Slots.Count, Mode=OneWay}" /><Run Text=" SLOTS" />
                            </TextBlock>
                            <Border Grid.Row="1" Margin="0,0,4,8" Padding="11,9" CornerRadius="8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelLineBrush}" BorderThickness="1"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,9,0" />
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" LineHeight="18"
                                               Text="Plug the amp in with its USB cable and switch it on. DifFuse finds it by itself." />
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="2" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                                     ItemContainerStyle="{StaticResource RackListItem}" IsEnabled="{Binding IsConnected}"
                                     AutomationProperties.Name="Amp preset slots" VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PresetSlotViewModel}">
                                        <!-- Each slot is a stop on a line; the one playing is the ringed interchange. -->
                                        <Grid AutomationProperties.Name="{Binding Label}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Width="2.5" Fill="{StaticResource TrackBrush}" Margin="0,-7" HorizontalAlignment="Center" />
                                            <Ellipse x:Name="Stop" Width="8" Height="8" Fill="{StaticResource SidebarBrush}" Stroke="{StaticResource InputHoverBorderBrush}" StrokeThickness="1.6"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Grid x:Name="Here" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                                <Ellipse Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="3" Fill="{StaticResource WindowBgBrush}" />
                                                <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Number}" FontStretch="SemiCondensed" FontSize="12.5"
                                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <TextBlock x:Name="Name" Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="Stop" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Here" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="LIBRARY" AutomationProperties.Name="Preset library">
                        <Grid Margin="10,0,6,10" DataContext="{Binding Library}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="BANK" Margin="4,0,0,6" />
                            <StackPanel Grid.Row="1" Margin="0,0,4,8">
                                <ComboBox ItemsSource="{Binding Banks}" SelectedItem="{Binding SelectedBank}" DisplayMemberPath="Name"
                                          AutomationProperties.Name="Bank" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding NewBankCommand}" ToolTip="New bank" AutomationProperties.Name="New bank" Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding RenameBankCommand}" ToolTip="Rename bank" AutomationProperties.Name="Rename bank" Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8AC;" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteBankCommand}" ToolTip="Move bank to the Recycle Bin" AutomationProperties.Name="Delete bank" Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding OpenFolderCommand}" ToolTip="Open the bank folder" AutomationProperties.Name="Open bank folder">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <ListBox x:Name="LibraryList" Grid.Row="2" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                     ItemContainerStyle="{StaticResource RackListItem}"
                                     AutomationProperties.Name="Library presets" MouseDoubleClick="LibraryList_MouseDoubleClick"
                                     KeyDown="LibraryList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid AutomationProperties.Name="{Binding Name}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Width="2.5" Fill="{StaticResource TrackBrush}" Margin="0,-7" HorizontalAlignment="Center" />
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource SidebarBrush}" Stroke="{StaticResource InputHoverBorderBrush}" StrokeThickness="1.6"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="2" TextWrapping="Wrap" Margin="4,8,4,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" LineHeight="18"
                                       Visibility="{Binding HasPresets, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                       Text="This bank is empty. Save the current sound here, or import FUSE .fuse files." />

                            <StackPanel Grid.Row="3" Margin="0,8,4,0">
                                <UniformGrid Columns="2" Margin="0,0,0,5">
                                    <Button Command="{Binding LoadCommand}" Margin="0,0,3,0" ToolTip="Play the selected preset on the amp (double-click works too)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" />
                                            <TextBlock Text="Load" Margin="7,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SaveCurrentCommand}" Margin="3,0,0,0" ToolTip="Save the current sound into this bank">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" />
                                            <TextBlock Text="Save here" Margin="7,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                                <UniformGrid Columns="4">
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding ImportCommand}" Margin="0,0,2,0" ToolTip="Import FUSE .fuse files into this bank" AutomationProperties.Name="Import FUSE files">
                                        <TextBlock Text="Import" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding ExportSelectedCommand}" Margin="2,0" ToolTip="Export the selected preset as a FUSE .fuse file" AutomationProperties.Name="Export selected preset">
                                        <TextBlock Text="Export" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding RenamePresetCommand}" Margin="2,0" ToolTip="Rename the selected preset" AutomationProperties.Name="Rename preset">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8AC;" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding DeletePresetCommand}" Margin="2,0,0,0" ToolTip="Move the selected preset to the Recycle Bin" AutomationProperties.Name="Delete preset">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" />
                                    </Button>
                                </UniformGrid>
                                <Button Style="{StaticResource ToolButton}" Command="{Binding ExportCurrentCommand}" Margin="0,5,0,0"
                                        ToolTip="Export the sound you are editing as a FUSE .fuse file">
                                    <TextBlock Text="Export current sound as .fuse…" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1" Width="1" Background="{StaticResource PanelLineBrush}" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Focusable="False" AutomationProperties.Name="Resize sidebar" Margin="-3,0" BorderThickness="3,0" BorderBrush="Transparent" />

            <!-- Signal path and units -->
            <Grid Grid.Column="2" Background="{StaticResource ChassisBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The route: input to output, one station per unit, the amp as the interchange -->
                <Grid x:Name="RouteMap" Margin="22,4,24,2" Height="74" AutomationProperties.Name="Signal path">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.ColumnSpan="3" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{StaticResource RouteBrush}" VerticalAlignment="Top" Margin="2,33,2,0" />

                    <Grid Width="62" ToolTip="Your guitar plugs in here">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="15" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="GUITAR" FontStretch="Condensed" FontWeight="Bold" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                        <Rectangle Grid.Row="1" Width="5" Height="17" RadiusX="2" RadiusY="2" Fill="{StaticResource RouteBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        <TextBlock Grid.Row="2" Text="Input" FontStretch="SemiCondensed" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </Grid>

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Chain}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChainItemViewModel}">
                                <Button Style="{StaticResource StationButton}" Click="Station_Click" Margin="3,0"
                                        ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding ToolTip}"
                                        AutomationProperties.HelpText="Show this unit">
                                    <Grid Height="74">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="15" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="Label" Text="{Binding Label}" FontStretch="Condensed" FontWeight="Bold" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                        <!-- On: a filled stop in the unit's ink -->
                                        <Ellipse x:Name="OnStop" Grid.Row="1" Width="17" Height="17" StrokeThickness="3" Stroke="{StaticResource RouteBrush}"
                                                 Fill="{Binding AccentKey, Converter={StaticResource ResourceBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                                        <!-- Bypassed: the line runs past a hollow stop -->
                                        <Ellipse x:Name="BypassStop" Grid.Row="1" Width="15" Height="15" StrokeThickness="2.5" StrokeDashArray="1.6 1.1"
                                                 Stroke="{Binding AccentKey, Converter={StaticResource ResourceBrush}}" Fill="{StaticResource WindowBgBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" Visibility="Collapsed" />
                                        <!-- Empty: a plain tick -->
                                        <Ellipse x:Name="EmptyStop" Grid.Row="1" Width="9" Height="9" StrokeThickness="2" Stroke="{StaticResource InputHoverBorderBrush}"
                                                 Fill="{StaticResource WindowBgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" Visibility="Collapsed" />
                                        <!-- Amp: the interchange -->
                                        <Grid x:Name="AmpStop" Grid.Row="1" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" Visibility="Collapsed">
                                            <Ellipse StrokeThickness="4.5" Stroke="{StaticResource RouteBrush}" Fill="{StaticResource WindowBgBrush}" />
                                            <Ellipse Width="9" Height="9" Fill="{StaticResource AmpBrush}" />
                                        </Grid>
                                        <TextBlock x:Name="Detail" Grid.Row="2" Text="{Binding Detail}" FontStretch="SemiCondensed" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsBypassed}" Value="True">
                                        <Setter TargetName="OnStop" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="BypassStop" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter TargetName="OnStop" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="EmptyStop" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAmp}" Value="True">
                                        <Setter TargetName="OnStop" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="AmpStop" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AmpBrush}" />
                                        <Setter TargetName="Label" Property="FontSize" Value="15" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Column="2" Width="80" ToolTip="The amp's speaker and USB audio output">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="15" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="OUTPUT" FontStretch="Condensed" FontWeight="Bold" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,5" />
                        <Rectangle Grid.Row="1" Width="5" Height="17" RadiusX="2" RadiusY="2" Fill="{StaticResource RouteBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        <TextBlock Grid.Row="2" Text="Speaker, USB" FontStretch="SemiCondensed" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,3,0,0" />
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="RackScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="RackPanel" Margin="14,4,14,4">
                        <ContentControl x:Name="AmpPanel" Style="{StaticResource UnitPanel}">
                            <v:AmpUnitView DataContext="{Binding Amp}" />
                        </ContentControl>

                        <ItemsControl x:Name="EffectList" ItemsSource="{Binding Effects}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EffectUnitViewModel}">
                                    <ContentControl Style="{StaticResource UnitPanel}">
                                        <v:EffectUnitView />
                                    </ContentControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Hint line: what the control under the pointer does; otherwise the latest status -->
        <Border Grid.Row="2" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource PanelLineBrush}" BorderThickness="0,1,0,0" Padding="16,6" MinHeight="31">
            <DockPanel>
                <Border DockPanel.Dock="Right" CornerRadius="10" Padding="9,1,10,2" Margin="12,0,0,0" BorderThickness="1.2" BorderBrush="{StaticResource InputBorderBrush}"
                        Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="SIMULATED AMP" FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Status"
                               Visibility="{Binding HasHint, Source={x:Static s:HintService.Current}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasHint, Source={x:Static s:HintService.Current}, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="{Binding Title, Source={x:Static s:HintService.Current}, Mode=OneWay, Converter={StaticResource Upper}}" FontWeight="SemiBold" FontStretch="SemiCondensed"
                             Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="   " /><Run Text="{Binding Text, Source={x:Static s:HintService.Current}, Mode=OneWay}"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
