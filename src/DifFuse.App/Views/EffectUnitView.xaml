<UserControl x:Class="DifFuse.App.Views.EffectUnitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DifFuse.App.Controls"
             xmlns:s="clr-namespace:DifFuse.App.Services"
             xmlns:vm="clr-namespace:DifFuse.App.ViewModels"
             c:Knob.ArcBrush="{Binding AccentKey, Converter={StaticResource ResourceBrush}}">
    <Grid Margin="16,8,16,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- On/bypass, name, placement, model -->
        <StackPanel VerticalAlignment="Center">
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton Style="{StaticResource PowerSwitch}" IsChecked="{Binding IsOn}" IsEnabled="{Binding HasModel}" VerticalAlignment="Center"
                              ToolTip="On / bypass" AutomationProperties.Name="{Binding Title, StringFormat={}{0} on}"
                              s:HintService.Title="On / bypass" s:HintService.Text="{x:Static vm:ControlGuide.Power}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource UnitTitle}" VerticalAlignment="Center" Margin="9,0,4,0"
                           TextTrimming="CharacterEllipsis" />
                <ToggleButton Grid.Column="2" Style="{StaticResource PlacementSwitch}" IsChecked="{Binding IsPostAmp}" VerticalAlignment="Center"
                              ToolTip="{Binding PlacementText}"
                              AutomationProperties.Name="{Binding Title, StringFormat={}{0} after the amp}"
                              s:HintService.Title="{Binding PlacementText}" s:HintService.Text="{x:Static vm:ControlGuide.Placement}" />
            </Grid>
            <ComboBox Margin="0,6,0,0" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="DisplayName"
                      AutomationProperties.Name="{Binding Title, StringFormat={}{0} model}"
                      s:HintService.Title="{Binding Title, StringFormat={}{0} model}" s:HintService.Text="{x:Static vm:ControlGuide.EffectModel}" />
        </StackPanel>

        <!-- Controls, in the same six columns on every effect unit -->
        <Grid Grid.Column="2" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Knobs}" ItemTemplate="{StaticResource KnobCell}" Focusable="False"
                          Opacity="{Binding IsActive, Converter={StaticResource ActiveOpacity}}"
                          Visibility="{Binding HasModel, Converter={StaticResource HiddenWhenFalse}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="Empty. Pick a model to add this effect." HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                       Visibility="{Binding HasModel, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
        </Grid>
    </Grid>
</UserControl>
