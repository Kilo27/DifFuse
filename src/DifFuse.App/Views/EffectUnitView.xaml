<UserControl x:Class="DifFuse.App.Views.EffectUnitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DifFuse.App.Controls"
             c:Knob.ArcBrush="{Binding AccentKey, Converter={StaticResource ResourceBrush}}">
    <Grid Margin="12,8,12,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="172" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="86" />
        </Grid.ColumnDefinitions>

        <!-- Power, name, model -->
        <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ToggleButton Style="{StaticResource PowerSwitch}" IsChecked="{Binding IsOn}" IsEnabled="{Binding HasModel}"
                              ToolTip="On / bypass" AutomationProperties.Name="{Binding Title, StringFormat={}{0} on}" />
                <Border Width="4" Height="18" CornerRadius="2" Margin="10,0,8,0"
                        Background="{Binding AccentKey, Converter={StaticResource ResourceBrush}}" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource UnitTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="DisplayName"
                      AutomationProperties.Name="{Binding Title, StringFormat={}{0} model}" ToolTip="Effect model" />
        </StackPanel>

        <!-- Knobs -->
        <Grid Grid.Column="1" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Knobs}" ItemTemplate="{StaticResource KnobTemplate}" Focusable="False" c:Knob.Size="40"
                          Opacity="{Binding IsActive, Converter={StaticResource ActiveOpacity}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="Empty. Pick a model to add this effect." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="12.5"
                       Visibility="{Binding HasModel, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
        </Grid>

        <!-- Placement -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
            <TextBlock Text="AMP" Style="{StaticResource PanelLabel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
            <ToggleButton Style="{StaticResource PlacementSwitch}" IsChecked="{Binding IsPostAmp}" HorizontalAlignment="Center"
                          ToolTip="Place this effect before (PRE) or after (POST) the amp"
                          AutomationProperties.Name="{Binding Title, StringFormat={}{0} after the amp}" />
            <TextBlock Style="{StaticResource PanelLabel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0">
                <Run Text="CHAIN #" /><Run Text="{Binding ChainPosition, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
