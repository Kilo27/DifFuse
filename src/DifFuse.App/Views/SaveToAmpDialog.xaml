<Window x:Class="DifFuse.App.Views.SaveToAmpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DifFuse.App.ViewModels"
        Title="Save to amp" Width="440" Height="560" MinHeight="420"
        ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PopupBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Grid x:Name="Root" Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Save to amp" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="Choose the preset slot to replace:" Margin="0,8,0,6" Foreground="{StaticResource TextSecondaryBrush}" />
        <Border Grid.Row="2" Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
            <ListBox x:Name="SlotList" ItemContainerStyle="{StaticResource RackListItem}" AutomationProperties.Name="Preset slot to replace"
                     SelectionChanged="SlotList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PresetSlotViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Visibility="{Binding IsCurrent, Converter={StaticResource HiddenWhenFalse}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Number}" FontFamily="{StaticResource LcdFont}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <TextBlock Grid.Row="3" Text="Preset name (up to 32 characters)" Margin="0,12,0,4" Foreground="{StaticResource TextSecondaryBrush}" />
        <TextBox x:Name="NameBox" Grid.Row="4" MaxLength="32" AutomationProperties.Name="Preset name" TextChanged="NameBox_TextChanged" />
        <TextBlock Grid.Row="5" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                   Text="The amp stores what you hear now. You will be asked to confirm before anything is replaced." />
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="Save…" IsDefault="True" MinWidth="96" Style="{StaticResource AccentButton}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
