<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:DifFuse.App.Controls"
                    xmlns:s="clr-namespace:DifFuse.App.Services"
                    xmlns:v="clr-namespace:DifFuse.App.Views"
                    xmlns:vm="clr-namespace:DifFuse.App.ViewModels">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <v:HiddenWhenFalseConverter x:Key="HiddenWhenFalse" />
    <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <v:ResourceBrushConverter x:Key="ResourceBrush" />
    <v:ConnectionLedConverter x:Key="ConnectionLed" />
    <v:ActiveOpacityConverter x:Key="ActiveOpacity" />
    <v:UpperConverter x:Key="Upper" />

    <!--
        Every control cell shares one skeleton so knobs, stops and switches line up across units:
        a label row, a 46 px control row whose centre is the line every control sits on, and a value row.
    -->
    <Style x:Key="ControlCell" TargetType="Grid">
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="900" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.36" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Knob: continuous amounts, mixes, and selectors with many positions -->
    <DataTemplate x:Key="DialTemplate" DataType="{x:Type vm:KnobViewModel}">
        <Grid Style="{StaticResource ControlCell}"
              Visibility="{Binding IsVisible, Converter={StaticResource HiddenWhenFalse}}"
              IsEnabled="{Binding IsEnabled}"
              s:HintService.Title="{Binding Label}" s:HintService.Text="{Binding Help}">
            <Grid.RowDefinitions>
                <RowDefinition Height="16" />
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Viewbox StretchDirection="DownOnly" VerticalAlignment="Bottom" HorizontalAlignment="Center"><TextBlock Text="{Binding Label, Converter={StaticResource Upper}}" Style="{StaticResource PanelLabel}" /></Viewbox>
            <c:Knob Grid.Row="1" Value="{Binding Value}" Maximum="{Binding Maximum}" DefaultValue="{Binding DefaultValue}" Diameter="42"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}"
                    AutomationProperties.ItemStatus="{Binding DisplayValue}" />
            <TextBlock Grid.Row="2" Text="{Binding DisplayValue}" Style="{StaticResource KnobValueText}" />
        </Grid>
    </DataTemplate>

    <!-- Stops: two to six named positions -->
    <DataTemplate x:Key="StopsTemplate" DataType="{x:Type vm:KnobViewModel}">
        <Grid Style="{StaticResource ControlCell}"
              Visibility="{Binding IsVisible, Converter={StaticResource HiddenWhenFalse}}"
              IsEnabled="{Binding IsEnabled}"
              s:HintService.Title="{Binding Label}" s:HintService.Text="{Binding Help}">
            <Grid.RowDefinitions>
                <RowDefinition Height="16" />
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Viewbox StretchDirection="DownOnly" VerticalAlignment="Bottom" HorizontalAlignment="Center"><TextBlock Text="{Binding Label, Converter={StaticResource Upper}}" Style="{StaticResource PanelLabel}" /></Viewbox>
            <c:StopSelector Grid.Row="1" Grid.RowSpan="2" Value="{Binding Value}" Maximum="{Binding Maximum}" Labels="{Binding PositionNames}"
                            Height="36" VerticalAlignment="Top" Margin="0,14,0,0" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}" />
        </Grid>
    </DataTemplate>

    <!-- Switch: off or on -->
    <DataTemplate x:Key="SwitchTemplate" DataType="{x:Type vm:KnobViewModel}">
        <Grid Style="{StaticResource ControlCell}"
              Visibility="{Binding IsVisible, Converter={StaticResource HiddenWhenFalse}}"
              IsEnabled="{Binding IsEnabled}"
              s:HintService.Title="{Binding Label}" s:HintService.Text="{Binding Help}">
            <Grid.RowDefinitions>
                <RowDefinition Height="16" />
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Viewbox StretchDirection="DownOnly" VerticalAlignment="Bottom" HorizontalAlignment="Center"><TextBlock Text="{Binding Label, Converter={StaticResource Upper}}" Style="{StaticResource PanelLabel}" /></Viewbox>
            <ToggleButton Grid.Row="1" Style="{StaticResource LineSwitch}" IsChecked="{Binding IsOn}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}" />
            <TextBlock Grid.Row="2" Text="{Binding DisplayValue}" Style="{StaticResource KnobValueText}" />
        </Grid>
    </DataTemplate>

    <!-- The cell for any parameter. Re-picks its control when an effect model redefines the parameter. -->
    <DataTemplate x:Key="KnobCell" DataType="{x:Type vm:KnobViewModel}">
        <ContentControl Content="{Binding}" Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource DialTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Stops">
                            <Setter Property="ContentTemplate" Value="{StaticResource StopsTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Switch">
                            <Setter Property="ContentTemplate" Value="{StaticResource SwitchTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </DataTemplate>

    <!-- "● PREAMP ———" : a section of a unit, a station dot in the unit's ink and a rule -->
    <Style x:Key="GroupHeader" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="2,0,6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"
                                 Fill="{Binding (c:Knob.ArcBrush), RelativeSource={RelativeSource TemplatedParent}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   Style="{StaticResource SectionTitle}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource PanelLineBrush}" Margin="9,1,0,0" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
