<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:DifFuse.App.Controls"
                    xmlns:v="clr-namespace:DifFuse.App.Views"
                    xmlns:vm="clr-namespace:DifFuse.App.ViewModels">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <v:HiddenWhenFalseConverter x:Key="HiddenWhenFalse" />
    <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <v:ResourceBrushConverter x:Key="ResourceBrush" />
    <v:ConnectionLedConverter x:Key="ConnectionLed" />
    <v:ActiveOpacityConverter x:Key="ActiveOpacity" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="KnobValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PanelFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A labelled knob with its value underneath. -->
    <DataTemplate x:Key="KnobTemplate" DataType="{x:Type vm:KnobViewModel}">
        <StackPanel MinWidth="50" Margin="1,0"
                    Visibility="{Binding IsVisible, Converter={StaticResource HiddenWhenFalse}}"
                    IsEnabled="{Binding IsEnabled}"
                    ToolTip="{Binding Label}">
            <TextBlock Text="{Binding Label}" Style="{StaticResource PanelLabel}" Margin="0,0,0,3" />
            <c:Knob Value="{Binding Value}" Maximum="{Binding Maximum}" DefaultValue="{Binding DefaultValue}"
                    Diameter="{Binding (c:Knob.Size), RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="{Binding Label}"
                    AutomationProperties.HelpText="{Binding DisplayValue}" />
            <TextBlock Text="{Binding DisplayValue}" Style="{StaticResource KnobValueText}" />
        </StackPanel>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="KnobRowPanel">
        <UniformGrid Rows="1" />
    </ItemsPanelTemplate>

</ResourceDictionary>
