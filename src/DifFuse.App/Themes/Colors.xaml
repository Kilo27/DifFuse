<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <Color x:Key="WindowBgColor">#FF101113</Color>
    <Color x:Key="ChassisColor">#FF16171A</Color>
    <Color x:Key="SidebarColor">#FF17181B</Color>
    <Color x:Key="PanelTopColor">#FF2C2F35</Color>
    <Color x:Key="PanelBottomColor">#FF1F2125</Color>
    <Color x:Key="PanelHighlightColor">#FF464A53</Color>
    <Color x:Key="PanelShadowColor">#FF0A0B0D</Color>
    <Color x:Key="EarTopColor">#FF34373D</Color>
    <Color x:Key="EarBottomColor">#FF212328</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FFECE8E1</Color>
    <Color x:Key="TextSecondaryColor">#FFA7AAB1</Color>
    <Color x:Key="TextMutedColor">#FF73777E</Color>

    <!-- Accents -->
    <Color x:Key="AccentColor">#FFF2A43A</Color>
    <Color x:Key="AccentDimColor">#FF5E4320</Color>
    <Color x:Key="LedRedColor">#FFFF4D3A</Color>
    <Color x:Key="LedGreenColor">#FF5BE36F</Color>
    <Color x:Key="DangerColor">#FFE5584F</Color>

    <Color x:Key="AmpColor">#FFF2A43A</Color>
    <Color x:Key="StompColor">#FFE5584F</Color>
    <Color x:Key="ModColor">#FF4EA6E8</Color>
    <Color x:Key="DelayColor">#FF5BC97F</Color>
    <Color x:Key="ReverbColor">#FFB084EC</Color>

    <!-- Inputs -->
    <Color x:Key="InputBgColor">#FF0F1012</Color>
    <Color x:Key="InputBorderColor">#FF33363C</Color>
    <Color x:Key="InputHoverBorderColor">#FF555A63</Color>
    <Color x:Key="HoverBgColor">#FF2A2D33</Color>
    <Color x:Key="PopupBgColor">#FF1C1D21</Color>

    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="ChassisBrush" Color="{StaticResource ChassisColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="PanelHighlightBrush" Color="{StaticResource PanelHighlightColor}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{StaticResource PanelShadowColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="LedRedBrush" Color="{StaticResource LedRedColor}" />
    <SolidColorBrush x:Key="LedGreenBrush" Color="{StaticResource LedGreenColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="AmpBrush" Color="{StaticResource AmpColor}" />
    <SolidColorBrush x:Key="StompBrush" Color="{StaticResource StompColor}" />
    <SolidColorBrush x:Key="ModBrush" Color="{StaticResource ModColor}" />
    <SolidColorBrush x:Key="DelayBrush" Color="{StaticResource DelayColor}" />
    <SolidColorBrush x:Key="ReverbBrush" Color="{StaticResource ReverbColor}" />
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{StaticResource InputHoverBorderColor}" />
    <SolidColorBrush x:Key="HoverBgBrush" Color="{StaticResource HoverBgColor}" />
    <SolidColorBrush x:Key="PopupBgBrush" Color="{StaticResource PopupBgColor}" />
    <SolidColorBrush x:Key="SelectedBgBrush" Color="#FF3A2C17" />
    <SolidColorBrush x:Key="LcdBgBrush" Color="#FF0D0A05" />
    <SolidColorBrush x:Key="LcdTextBrush" Color="#FFFFB347" />
    <SolidColorBrush x:Key="LcdDimBrush" Color="#FF8C6328" />

    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource PanelTopColor}" />
        <GradientStop Offset="1" Color="{StaticResource PanelBottomColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AmpPanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF33302B" />
        <GradientStop Offset="1" Color="#FF221F1B" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="EarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource EarBottomColor}" />
        <GradientStop Offset="0.5" Color="{StaticResource EarTopColor}" />
        <GradientStop Offset="1" Color="{StaticResource EarBottomColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF34373D" />
        <GradientStop Offset="1" Color="#FF27292E" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF40444B" />
        <GradientStop Offset="1" Color="#FF2F3237" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="ScrewBrush" GradientOrigin="0.35,0.3" Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
        <GradientStop Offset="0" Color="#FF8D9199" />
        <GradientStop Offset="0.6" Color="#FF4B4F56" />
        <GradientStop Offset="1" Color="#FF1E2024" />
    </RadialGradientBrush>

    <!-- Faint horizontal brushing on faceplates -->
    <DrawingBrush x:Key="BrushedMetalBrush" TileMode="Tile" Viewport="0,0,6,3" ViewportUnits="Absolute" Opacity="0.05">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFFFF" Geometry="M0,0 H6 V1 H0 Z" />
                <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,1 H6 V3 H0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <FontFamily x:Key="PanelFont">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="LcdFont">Cascadia Mono, Consolas</FontFamily>

</ResourceDictionary>
