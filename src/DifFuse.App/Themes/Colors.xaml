<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Midnight enamel transit diagram. The ground is deep enamel blue; line work, rings and type are
        porcelain; each unit owns one line ink. The custom-drawn controls mirror these in Controls/Ink.cs.
    -->

    <!-- Surfaces -->
    <Color x:Key="WindowBgColor">#FF0A1230</Color>
    <Color x:Key="ChromeColor">#FF070D25</Color>
    <Color x:Key="SidebarColor">#FF0B1434</Color>
    <Color x:Key="PanelColor">#FF0F1A40</Color>
    <Color x:Key="PanelLineColor">#FF26325C</Color>
    <Color x:Key="TrackColor">#FF23305E</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FFF3F1EA</Color>
    <Color x:Key="TextSecondaryColor">#FFB6BED6</Color>
    <Color x:Key="TextMutedColor">#FF8A95B8</Color>

    <!-- Line inks: one per unit -->
    <Color x:Key="AmpColor">#FFFFC20E</Color>
    <Color x:Key="StompColor">#FFF0383A</Color>
    <Color x:Key="ModColor">#FF3F7BFF</Color>
    <Color x:Key="DelayColor">#FF2FBF5B</Color>
    <Color x:Key="ReverbColor">#FFA978FF</Color>

    <!-- Brand and state -->
    <Color x:Key="AccentColor">#FFFFC20E</Color>
    <Color x:Key="AccentDimColor">#FF6B5A1E</Color>
    <Color x:Key="LedRedColor">#FFF0383A</Color>
    <Color x:Key="LedGreenColor">#FF3DD47A</Color>
    <Color x:Key="DangerColor">#FFF0383A</Color>

    <!-- Inputs -->
    <Color x:Key="InputBgColor">#FF08102A</Color>
    <Color x:Key="InputBorderColor">#FF33406E</Color>
    <Color x:Key="InputHoverBorderColor">#FF5A6799</Color>
    <Color x:Key="HoverBgColor">#FF17234D</Color>
    <Color x:Key="SelectedBgColor">#FF1D2C5E</Color>
    <Color x:Key="PopupBgColor">#FF0E1839</Color>

    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="ChassisBrush" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelLineBrush" Color="{StaticResource PanelLineColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="RouteBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="LedRedBrush" Color="{StaticResource LedRedColor}" />
    <SolidColorBrush x:Key="LedGreenBrush" Color="{StaticResource LedGreenColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="AmpBrush" Color="{StaticResource AmpColor}" />
    <SolidColorBrush x:Key="StompBrush" Color="{StaticResource StompColor}" />
    <SolidColorBrush x:Key="ModBrush" Color="{StaticResource ModColor}" />
    <SolidColorBrush x:Key="DelayBrush" Color="{StaticResource DelayColor}" />
    <SolidColorBrush x:Key="ReverbBrush" Color="{StaticResource ReverbColor}" />
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{StaticResource InputHoverBorderColor}" />
    <SolidColorBrush x:Key="HoverBgBrush" Color="{StaticResource HoverBgColor}" />
    <SolidColorBrush x:Key="SelectedBgBrush" Color="{StaticResource SelectedBgColor}" />
    <SolidColorBrush x:Key="PopupBgBrush" Color="{StaticResource PopupBgColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource TextPrimaryColor}" />

    <!-- One family carries everything: Bahnschrift, the DIN of road and rail signs. -->
    <FontFamily x:Key="UiFont">Bahnschrift</FontFamily>
    <FontFamily x:Key="PanelFont">Bahnschrift</FontFamily>
    <FontFamily x:Key="LcdFont">Bahnschrift</FontFamily>

</ResourceDictionary>
